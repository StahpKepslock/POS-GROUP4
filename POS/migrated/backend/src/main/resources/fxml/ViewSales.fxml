<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.pos.controllers.ViewSalesController"
      spacing="10" prefHeight="600.0" prefWidth="800.0">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <TableView fx:id="salesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="saleIdColumn" text="ID"/>
            <TableColumn fx:id="dateColumn" text="Date"/>
            <TableColumn fx:id="totalColumn" text="Total"/>
        </columns>
    </TableView>
</VBox>