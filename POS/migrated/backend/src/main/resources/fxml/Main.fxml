<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.pos.controllers.MainController"
            prefHeight="600.0" prefWidth="800.0">
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Exit" onAction="#handleExit"/>
            </Menu>
        </MenuBar>
    </top>
    <center>
        <VBox spacing="10" alignment="CENTER">
            <Button text="New Sale" onAction="#handleNewSale"/>
            <Button text="View Sales" onAction="#handleViewSales"/>
            <Button text="Manage Products" onAction="#handleManageProducts"/>
        </VBox>
    </center>
</BorderPane>